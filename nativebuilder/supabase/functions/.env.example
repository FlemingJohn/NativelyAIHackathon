# ============================================================================
# Edge Function secrets -- SERVER SIDE ONLY
# ============================================================================
# These never reach the browser. Set them in:
#   Supabase dashboard -> Edge Functions -> Secrets
# or:
#   supabase secrets set --env-file supabase/functions/.env
#
# Do NOT put any of these in the frontend .env -- anything VITE_-prefixed is
# compiled into the public JS bundle. Frontend keys live in ../../.env.example
# and are limited to the Supabase URL + anon key on purpose.
# ============================================================================

# --- AI/ML API (required) ---------------------------------------------------
# Hackathon credits: https://aimlapi.com
AIML_API_KEY=
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_FAST_MODEL=gpt-4o-mini
AIML_REASONING_MODEL=gpt-4o

# --- Bright Data (optional, but it's what makes cofounder search work) ------
# Without a token every module falls back to DuckDuckGo HTML search, which
# ignores `site:` filters and can't reach LinkedIn -- so cofounder search
# returns nothing. With a token:
#   * SERP API replaces DuckDuckGo everywhere (parsed Google results)
#   * cofounder search adds a second stage: LinkedIn Profiles dataset on the
#     profile URLs the SERP step found
#
# Token: Bright Data dashboard -> Account settings -> API tokens
BRIGHTDATA_API_TOKEN=

# Zone names from Bright Data -> Proxies & Scraping. The unlocker zone is used
# for plain page fetches; SERP falls back to it if no separate zone is set.
BRIGHTDATA_WEB_UNLOCKER_ZONE=mcp_unlocker
BRIGHTDATA_SERP_ZONE=serp_api

# --- Injected by Supabase, do not set ---------------------------------------
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY
