# ============================================================================
# Edge Function secrets -- SERVER SIDE ONLY
# ============================================================================
# These never reach the browser. Set them in:
#   Supabase dashboard -> Edge Functions -> Secrets
# or:
#   supabase secrets set --env-file supabase/functions/.env
#
# Do NOT put any of these in the frontend .env -- anything VITE_-prefixed is
# compiled into the public JS bundle. Frontend keys live in ../../.env.example
# and are limited to the Supabase URL + anon key on purpose.
# ============================================================================

# --- AI/ML API (required) ---------------------------------------------------
# Hackathon credits: https://aimlapi.com
AIML_API_KEY=
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_FAST_MODEL=gpt-4o-mini
AIML_REASONING_MODEL=gpt-4o

# --- Bright Data (not wired up) ---------------------------------------------
# Nothing reads these yet. _shared/search.ts uses DuckDuckGo, because the
# Bright Data account is still behind payment verification (see bright-data.md).
# Once that clears, port brightdataClient.ts into _shared/ and switch
# search.ts's export -- then these two start mattering.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_WEB_UNLOCKER_ZONE=mcp_unlocker

# --- Injected by Supabase, do not set ---------------------------------------
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY
